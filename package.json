{
  "name": "copilot-kickoff-demo",
  "private": true,
  "version": "1.0.0",
  "description": "A local-first GitHub Copilot presentation lab for slides 9-14.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test --test-reporter=spec src/domain/triage.test.ts scripts/demo.test.mjs",
    "check": "npm test && npm run lint && npm run build",
    "demo:status": "node scripts/demo.mjs status",
    "demo:pr": "node scripts/demo.mjs pr",
    "demo:bug": "node scripts/demo.mjs review-bug",
    "demo:baseline": "node scripts/demo.mjs baseline"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
